{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun"]
  },
  "include": ["cli/**/*.ts", "lib/**/*.ts", "workflows/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
