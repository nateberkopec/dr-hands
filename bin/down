#!/usr/bin/env fish

source (status dirname)/../lib/box.fish

set -l failed 0
set -l reports (box_workspaces); or set failed 1
for dir in $repo/state/*/
    set reports $reports (basename $dir)
end
for id in (printf '%s\n' $reports | sort -u | string match -v '')
    parse_report $id
    remove_box; or set failed 1
end

set -l instances (aws ec2 describe-instances --filters Name=tag:dr-hands,Values=box Name=instance-state-name,Values=pending,running,stopping,stopped \
    --query 'Reservations[].Instances[].InstanceId' --output text)
or begin
    echo "dr-hands: could not list instances" >&2
    set failed 1
end
for instance in (string split -n \t -- $instances)
    aws ec2 terminate-instances --instance-ids $instance >/dev/null
    and echo "Terminated leftover instance $instance"
    or set failed 1
end
set -l devices (tailnet_devices ''); or begin
    echo "dr-hands: could not list tailnet devices" >&2
    set failed 1
end
for device in $devices
    tailscale_api DELETE /device/(echo $device | jq -r .id) >/dev/null
    and echo "Removed leftover tailnet device "(echo $device | jq -r .name)
    or set failed 1
end
set -l grants (broker GET /grants); or begin
    echo "dr-hands: could not list broker keys" >&2
    set failed 1
end
for grant in (printf '%s\n' $grants | jq -r '.[].report')
    broker DELETE /grants/$grant >/dev/null
    and echo "Revoked leftover broker key for $grant"
    or set failed 1
end
exit $failed
