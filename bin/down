#!/usr/bin/env fish

source (status dirname)/../lib/box.fish

set -l failed 0
set -l reports (terraform_box workspace list | string trim -c ' *' | string match -v -e default | string match -v '')
for dir in $repo/state/*/
    set reports $reports (basename $dir)
end
for id in (printf '%s\n' $reports | sort -u)
    parse_report $id
    remove_box; or set failed 1
end

for instance in (aws ec2 describe-instances --filters Name=tag:dr-hands,Values=box Name=instance-state-name,Values=pending,running,stopping,stopped \
        --query 'Reservations[].Instances[].InstanceId' --output text | string split -n \t)
    aws ec2 terminate-instances --instance-ids $instance >/dev/null
    and echo "Terminated leftover instance $instance"
    or set failed 1
end
for device in (tailnet_devices '')
    tailscale_api DELETE /device/(echo $device | jq -r .id) >/dev/null
    and echo "Removed leftover tailnet device "(echo $device | jq -r .name)
    or set failed 1
end
for grant in (broker GET /grants | jq -r '.[].report')
    broker DELETE /grants/$grant >/dev/null
    and echo "Revoked leftover broker key for $grant"
    or set failed 1
end
exit $failed
