#!/usr/bin/env fish

source (status dirname)/../lib/box.fish

test (count $argv) -eq 1; or fail "usage: patch GHSA-xxxx-xxxx-xxxx"
parse_report $argv[1]
test -f $state/known_hosts; or fail "$report has no box"
set -l name (string split / -- (string trim < $state/github-repo))[2]

box_ssh "git -C ~/work/$name format-patch --stdout origin/HEAD..fix" >$state/fix.patch
or fail "could not read branch fix from the box"
test -s $state/fix.patch; or fail "branch fix has no commits"

set -l patterns (cat $repo/lib/risky-files $repo/stacks/*/risky-files | string match -v '')
set -l flagged 0
echo "$report: fix saved to $state/fix.patch"
for line in (git apply --numstat $state/fix.patch)
    set -l path (string split -m2 \t -- $line)[3]
    set -l mark ' '
    for pattern in $patterns
        if string match -q -- $pattern $path; or string match -q -- "*/$pattern" $path
            set mark '!'
            set flagged 1
            break
        end
    end
    echo "  $mark $line"
end
test $flagged -eq 0; or echo "Files marked ! change tooling, dependencies or build steps. Read them first."
