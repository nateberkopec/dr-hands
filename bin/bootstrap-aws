#!/usr/bin/env fish

argparse 'email=' 'alert-email=' 'region=' 'budget=' 'vault=' create-organization -- $argv
or exit 1

function fail
    echo "bootstrap-aws: $argv" >&2
    exit 1
end

set -q _flag_email
or fail "--email is required: a new address for the dr-hands AWS account, such as you+dr-hands@example.com"
set -g region $DR_HANDS_REGION
set -q _flag_region; and set region $_flag_region
test -n "$region"; or fail "set --region or DR_HANDS_REGION"
set -g budget 50
set -q _flag_budget; and set budget $_flag_budget
set -g alert_email $_flag_email
set -q _flag_alert_email; and set alert_email $_flag_alert_email
set -g vault Private
set -q _flag_vault; and set vault $_flag_vault
set -g repo (realpath (status dirname)/..)

set -g caller (aws sts get-caller-identity --query Arn --output text 2>/dev/null)
or fail "no AWS credentials; run `aws login` as the management account's root user first"
echo "Running as $caller"

if not aws organizations describe-organization >/dev/null 2>&1
    set -q _flag_create_organization
    or fail "this account has no AWS Organization; rerun with --create-organization to make it the management account of a new one"
    aws organizations create-organization --feature-set ALL >/dev/null
    or fail "could not create an organization"
    echo "Created an AWS Organization"
end

set -g account_id (aws organizations list-accounts --query "Accounts[?Name=='dr-hands' && Status=='ACTIVE'].Id | [0]" --output text)
or fail "could not list organization accounts"
if test "$account_id" = None
    set -l request (aws organizations create-account --email $_flag_email --account-name dr-hands --iam-user-access-to-billing ALLOW --query CreateAccountStatus.Id --output text)
    or fail "create-account failed"
    echo "Creating the dr-hands account"
    set account_id ""
    for i in (seq 90)
        set -l result (aws organizations describe-create-account-status --create-account-request-id $request --query 'CreateAccountStatus.[State,AccountId,FailureReason]' --output text | string split \t)
        switch $result[1]
            case SUCCEEDED
                set account_id $result[2]
                break
            case FAILED
                fail "account creation failed: $result[3]"
        end
        sleep 5
    end
    test -n "$account_id"; or fail "account creation did not finish in time; rerun to pick it up"
end
echo "dr-hands account: $account_id"

set -g role_arn "arn:aws:iam::$account_id:role/OrganizationAccountAccessRole"
set -g temp_user
set -g member_creds

function cleanup --on-event fish_exit
    test -n "$temp_user"; or return
    for key in (aws iam list-access-keys --user-name $temp_user --query 'AccessKeyMetadata[].AccessKeyId' --output text | string split -n \t)
        aws iam delete-access-key --user-name $temp_user --access-key-id $key
    end
    aws iam delete-user-policy --user-name $temp_user --policy-name assume-dr-hands >/dev/null 2>&1
    aws iam delete-user --user-name $temp_user
    and echo "Deleted temporary user $temp_user"
end

function assume_role
    aws sts assume-role --role-arn $role_arn --role-session-name dr-hands-bootstrap --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' --output text 2>/dev/null
end

function assume_role_as --argument-names key_id secret
    set -lx AWS_ACCESS_KEY_ID $key_id
    set -lx AWS_SECRET_ACCESS_KEY $secret
    assume_role
end

function member
    set -lx AWS_ACCESS_KEY_ID $member_creds[1]
    set -lx AWS_SECRET_ACCESS_KEY $member_creds[2]
    set -lx AWS_SESSION_TOKEN $member_creds[3]
    aws $argv
end

if string match -q 'arn:aws:iam::*:root' -- $caller
    set temp_user dr-hands-bootstrap-(random 100000 999999)
    aws iam create-user --user-name $temp_user >/dev/null
    or fail "could not create the temporary user"
    echo "Created temporary user $temp_user, because root cannot assume roles; it is deleted when this script exits"
    aws iam put-user-policy --user-name $temp_user --policy-name assume-dr-hands --policy-document (jq -cn --arg arn $role_arn '{Version:"2012-10-17",Statement:[{Effect:"Allow",Action:"sts:AssumeRole",Resource:$arn}]}')
    or fail "could not grant the temporary user"
    set -l temp_key (aws iam create-access-key --user-name $temp_user --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text | string split \t)
    test (count $temp_key) -eq 2; or fail "could not create a temporary access key"
    for i in (seq 30)
        set member_creds (assume_role_as $temp_key[1] $temp_key[2] | string split \t)
        test (count $member_creds) -eq 3; and break
        sleep 2
    end
else
    for i in (seq 30)
        set member_creds (assume_role | string split \t)
        test (count $member_creds) -eq 3; and break
        sleep 2
    end
end
test (count $member_creds) -eq 3; or fail "could not assume $role_arn"

member ec2 enable-ebs-encryption-by-default --region $region >/dev/null
or fail "could not turn on EBS encryption by default"
member ec2 modify-instance-metadata-defaults --region $region --http-tokens required --http-put-response-hop-limit 1 >/dev/null
or fail "could not set instance metadata defaults"

if member budgets describe-budget --account-id $account_id --budget-name dr-hands >/dev/null 2>&1
    echo "Budget dr-hands already exists"
else
    member budgets create-budget --account-id $account_id \
        --budget (jq -cn --arg amount $budget '{BudgetName:"dr-hands",BudgetLimit:{Amount:$amount,Unit:"USD"},TimeUnit:"MONTHLY",BudgetType:"COST"}') \
        --notifications-with-subscribers (jq -cn --arg email $alert_email '[{Notification:{NotificationType:"ACTUAL",ComparisonOperator:"GREATER_THAN",Threshold:80,ThresholdType:"PERCENTAGE"},Subscribers:[{SubscriptionType:"EMAIL",Address:$email}]},{Notification:{NotificationType:"FORECASTED",ComparisonOperator:"GREATER_THAN",Threshold:100,ThresholdType:"PERCENTAGE"},Subscribers:[{SubscriptionType:"EMAIL",Address:$email}]}]')
    or fail "could not create the budget"
    echo "Created a \$$budget monthly budget alerting $alert_email"
end

member iam get-user --user-name dr-hands-deploy >/dev/null 2>&1
and fail "dr-hands-deploy already exists in $account_id; delete it to bootstrap again"
member iam create-user --user-name dr-hands-deploy >/dev/null
or fail "could not create dr-hands-deploy"
member iam put-user-policy --user-name dr-hands-deploy --policy-name dr-hands-deploy --policy-document (string replace -a REGION $region < $repo/aws/deploy-policy.json | string collect)
or fail "could not attach the deploy policy"

set -l deploy_key (member iam create-access-key --user-name dr-hands-deploy --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text | string split \t)
test (count $deploy_key) -eq 2; or fail "could not create the deploy access key"
begin
    set -lx KEY_ID $deploy_key[1]
    set -lx SECRET $deploy_key[2]
    set -lx ACCOUNT $account_id
    set -lx REGION $region
    jq -n '{title:"dr-hands-aws-deploy",category:"API_CREDENTIAL",fields:[{id:"username",type:"STRING",label:"username",value:env.KEY_ID},{id:"credential",type:"CONCEALED",label:"credential",value:env.SECRET},{id:"account",type:"STRING",label:"account",value:env.ACCOUNT},{id:"region",type:"STRING",label:"region",value:env.REGION}]}' | op item create --vault $vault - >/dev/null
end
or begin
    member iam delete-access-key --user-name dr-hands-deploy --access-key-id $deploy_key[1]
    fail "could not save the deploy key to 1Password; the key was deleted"
end
echo "Saved the deploy key to 1Password as $vault/dr-hands-aws-deploy"
echo "Done. dr-hands account $account_id, region $region."
