#!/usr/bin/env fish

source (status dirname)/../lib/box.fish

argparse no-attach -- $argv
or exit 1
test (count $argv) -eq 2; or fail "usage: add OWNER/REPO GHSA-xxxx-xxxx-xxxx [--no-attach]"
set -g github_repo $argv[1]
string match -rq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' -- $github_repo; or fail "$github_repo is not OWNER/REPO"
parse_report $argv[2]
test -d $state; and fail "$report already has a box; use `mise run attach $report` or `mise run rm $report`"
test -f $repo/state/image; or fail "no image yet; run `mise run image`"
set -l image (string split ' ' -- (string trim < $repo/state/image))
test (count $image) -eq 2; or fail "state/image is invalid; run `mise run image`"
set -l fingerprint (current_provisioner image-fingerprint); or fail "could not fingerprint the provisioner image"
test (count $fingerprint) -eq 1; and string match -rq '^[A-Za-z0-9._:/@+-]+$' -- "$fingerprint"; or fail "provisioner returned an invalid image fingerprint"
test "$image[2]" = "$fingerprint"; or fail "the image is out of date with stacks/, image/ or the settings; run `mise run image`"
set image $image[1]

current_provisioner init; or fail "provisioner initialization failed"
set -l provisioner_spec (configured_provisioner_spec); or exit 1
test -f $ssh_key; or ssh-keygen -q -t ed25519 -N '' -C dr-hands -f $ssh_key
mkdir -p $state
echo $provisioner_spec >$state/provisioner
echo $github_repo >$state/github-repo
source $repo/lib/fetch.fish
fetch_advisory; or begin
    rm -rf $state
    exit 1
end

function abort
    echo dr-hands: $argv >&2
    echo "Removing what was created for $report" >&2
    remove_box
    exit 1
end

echo "Creating the box"
set -l auth_key (tailscale_api POST '/tailnet/-/keys' -d (jq -cn --arg d "dr-hands $box" '{capabilities:{devices:{create:{reusable:false,ephemeral:true,preauthorized:true,tags:["tag:ghsa"]}}},expirySeconds:600,description:$d}') | jq -r .key)
test -n "$auth_key"; or abort "could not create a tailnet auth key"
set -lx DR_HANDS_RUN $box
set -lx DR_HANDS_IMAGE $image
set -lx DR_HANDS_SSH_PUBLIC_KEY (string trim < $ssh_key.pub)
set -lx DR_HANDS_TAILNET_AUTH_KEY $auth_key
set -l resource (run_provisioner create); or abort "provisioner create failed"
set -e DR_HANDS_TAILNET_AUTH_KEY
test (count $resource) -eq 1; and string match -rq '^[A-Za-z0-9._:/@+-]+$' -- "$resource"; or abort "provisioner returned an invalid resource"
echo $resource >$state/provisioner-resource

set -l device
for i in (seq 60)
    set device (tailnet_devices $box. | jq -c 'select(.connectedToControl)')
    test (count $device) -eq 1; and break
    sleep 5
end
test (count $device) -eq 1; or abort "the box did not join the tailnet"
echo $device | jq -r '.addresses[] | select(test("^100\\."))' >$state/ip

set -lx DR_HANDS_RESOURCE $resource
set -l host_key (run_provisioner ssh-host-key); or abort "could not read the box's SSH host key"
test (count $host_key) -eq 1; and string match -rq '^ssh-ed25519 [A-Za-z0-9+/=]+(?: [A-Za-z0-9._@+-]+)?$' -- "$host_key"; or abort "the provisioner returned an invalid SSH host key"
echo (string trim < $state/ip) $host_key >$state/known_hosts
run_provisioner seal; or abort "could not seal the provisioned box"

for i in (seq 30)
    box_ssh true 2>/dev/null; and break
    sleep 5
end
box_ssh true; or abort "could not SSH to the box"

set -l broker_key (broker POST /grants (jq -cn --arg r $box '{report:$r,ttlSeconds:43200}') | jq -r .key)
test -n "$broker_key"; or abort "could not mint a broker key"
jq -n --arg k $broker_key '{meridian:{type:"api_key",key:$k},openai:{type:"api_key",key:$k},"vercel-ai-gateway":{type:"api_key",key:$k}}' \
    | box_ssh 'umask 077 && cat > ~/.pi/agent/auth.json'
or abort "could not give the box its broker key"
jq -n --arg url https://$DR_HANDS_BROKER_HOST:3460 '{providers:{meridian:{baseUrl:"\($url)/claude"},openai:{baseUrl:"\($url)/chatgpt/v1"},"vercel-ai-gateway":{baseUrl:"\($url)/vercel"}}}' \
    | box_ssh 'cat > ~/.pi/agent/models.json'
or abort "could not give the box its model routes"
push_advisory; or abort "could not copy the advisory to the box"
set -l name (string split / -- $github_repo)[2]
box_ssh "bash -lc 'git clone --quiet https://github.com/$github_repo.git ~/work/$name'"
or abort "could not clone $github_repo on the box"
push_fork; or abort "could not copy the private fork to the box"

echo "$report: ready"
set -q _flag_no_attach; or exec $repo/bin/attach $report
