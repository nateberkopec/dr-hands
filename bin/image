#!/usr/bin/env fish

source (status dirname)/../lib/box.fish

set -l fingerprint (current_provisioner image-fingerprint); or fail "could not fingerprint the provisioner image"
test (count $fingerprint) -eq 1; and string match -rq '^[A-Za-z0-9._:/@+-]+$' -- "$fingerprint"; or fail "provisioner returned an invalid image fingerprint"
set -lx DR_HANDS_IMAGE_FINGERPRINT $fingerprint
set -l image (current_provisioner build-image); or fail "provisioner image build failed"
test (count $image) -eq 1; and string match -rq '^[A-Za-z0-9._:/@+-]+$' -- "$image"; or fail "provisioner returned an invalid image"
mkdir -p $repo/state
echo $image $fingerprint >$repo/state/image
echo "Image $image is ready and recorded in state/image"
