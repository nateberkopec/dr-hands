{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dr-hands.example/provisioners/v1/request.schema.json",
  "type": "object",
  "required": ["protocolVersion", "operationId", "run", "roles", "paths", "managementPublicKey"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {"const": 1},
    "operationId": {"type": "string", "minLength": 1},
    "run": {
      "type": "object",
      "required": ["id", "generation", "mode", "expiresAt"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["box", "gravity"]},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "image"],
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["box", "attacker", "target"]},
          "image": {"type": "string", "minLength": 1}
        }
      }
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["from", "to", "service"],
        "additionalProperties": false,
        "properties": {
          "from": {"enum": ["management", "box", "attacker", "target"]},
          "to": {"enum": ["box", "attacker", "target", "openrouter", "package-proxy", "broker"]},
          "service": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        }
      }
    },
    "managementPublicKey": {"type": "string", "pattern": "^ssh-ed25519 "}
  },
  "allOf": [
    {
      "if": {"properties": {"run": {"type": "object", "properties": {"mode": {"const": "box"}}}}},
      "then": {
        "properties": {
          "roles": {
            "type": "array",
            "maxItems": 1,
            "contains": {"type": "object", "properties": {"name": {"const": "box"}}}
          }
        }
      },
      "else": {
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {"type": "array", "contains": {"type": "object", "properties": {"name": {"const": "attacker"}}}},
              {"type": "array", "contains": {"type": "object", "properties": {"name": {"const": "target"}}}}
            ]
          }
        }
      }
    }
  ]
}
